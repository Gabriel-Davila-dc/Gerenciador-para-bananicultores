# Hospedagem Apache (Hostinger): as rotas do Angular não existem como arquivo.
# Abrir ou atualizar /gerenciador/crm daria 404; aqui, o que não for arquivo nem
# pasta de verdade devolve o index.html, e o roteador do Angular resolve a tela.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# index.html sem cache: senão, depois de publicar versão nova, o celular segue
# pedindo os arquivos antigos. Os .js e .css têm hash no nome e podem ficar em cache.
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

# PWA: o navegador precisa receber o manifest com o tipo certo, e o service
# worker (e a lista de arquivos dele) nunca pode ficar em cache — senão a
# atualização do app não chega no celular de quem já instalou.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(ngsw-worker\.js|ngsw\.json|safety-worker\.js|worker-basic\.min\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
